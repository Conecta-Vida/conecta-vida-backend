# Copie para .env e preencha localmente. Nunca versione o .env real.
DATABASE_URL=jdbc:postgresql://SEU_HOST.pooler.supabase.com:6543/postgres?prepareThreshold=0&sslmode=require
DATABASE_USERNAME=postgres.SE_REF_DO_PROJETO
DATABASE_PASSWORD=
# Deve ser idêntico ao salt utilizado pela Admin API.
CONECTA_API_SALT=
# Segredo somente da Mobile API; gere uma string aleatória com pelo menos 32 caracteres.
CONECTA_JWT_SECRET=
CONECTA_MOBILE_CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
